      "key": "refresh",
      "label": {
        "en": "Refresh the prices now",
        "fr": "Relever les prix maintenant",
        "de": "Preise jetzt abrufen",
        "es": "Actualizar los precios ahora"
      },
      "description": {
        "en": "Reads ComEd now and shows the latest 5-minute price and whether tomorrow's prices are out.",
        "fr": "Interroge ComEd maintenant et affiche le dernier prix à 5 minutes, et si les prix de demain sont publiés.",
        "de": "Fragt ComEd jetzt ab und zeigt den letzten 5-Minuten-Preis und ob die Preise für morgen veröffentlicht sind.",
        "es": "Consulta ComEd ahora y muestra el último precio de 5 minutos y si los precios de mañana están publicados."
      },
      "timeout_seconds": 50
